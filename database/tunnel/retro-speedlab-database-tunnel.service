[Unit]
Description=Retro Speedlab database tunnel: Superset on the main server's docker bridge
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
LoadCredential=key:/etc/retro-speedlab/database-tunnel/id_ed25519
LoadCredential=known_hosts:/etc/retro-speedlab/database-tunnel/known_hosts
ExecStart=/usr/bin/ssh -N -T -i %d/key \
    -o IdentitiesOnly=yes -o BatchMode=yes -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
    -o StrictHostKeyChecking=yes -o UserKnownHostsFile=%d/known_hosts \
    -R 172.17.0.1:18088:127.0.0.1:18088 database-tunnel@178.104.84.157
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
