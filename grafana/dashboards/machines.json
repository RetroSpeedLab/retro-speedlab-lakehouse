        "type": "query",
        "name": "host",
        "label": "Host",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "experiments"
        },
        "query": "SELECT DISTINCT host FROM host_metrics",
        "definition": "SELECT DISTINCT host FROM host_metrics",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU",
      "description": "CPU utilisation over the last minute",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "experiments"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "experiments"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT measured_at AS time, host AS metric, cpu_percent AS value FROM host_metrics WHERE host IN ($host) AND $__timeFilter(measured_at) ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "spanNulls": true,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
