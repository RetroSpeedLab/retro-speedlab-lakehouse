{
  "uid": "promotion",
  "title": "Promotion variants",
  "tags": [
    "retro-speedlab"
  ],
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "panels": [
    {
      "type": "table",
      "title": "Variants per channel",
      "description": "Each channel's promotion variants with their reach per dollar and its interval",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "experiments"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "experiments"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT channel, variant, drafts, cost_usd, views, likes, follows, views_per_dollar, views_lower, views_upper, likes_per_dollar, likes_lower, likes_upper, computed_at FROM promotion_roi ORDER BY channel, variant"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "verdict"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "better": {
                        "color": "green",
                        "index": 0
                      },
                      "worse": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Bluesky engagement per dimension",
      "description": "Each post dimension's likes, reposts, replies and quotes a day after posting, per post at today's follower count, with its interval and its share of the next posts",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "experiments"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "experiments"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT replace(surface, 'bluesky_', '') AS dimension, item AS value, exposures AS posts, outcomes AS engagement, mean AS engagement_per_post, lower, upper, share, computed_at FROM content_ranking WHERE surface LIKE 'bluesky\\_%' ORDER BY surface, mean DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "What the owner approves on YouTube",
      "description": "The approval rate of each YouTube Short feature with its interval",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "experiments"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "experiments"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT feature, value, decisions, approved, rejected, approval_rate, lower, upper FROM promotion_preferences WHERE channel = 'youtube' ORDER BY feature, approval_rate DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "verdict"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "better": {
                        "color": "green",
                        "index": 0
                      },
                      "worse": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Ko-fi supporters",
      "description": "Ko-fi payments per kind and currency: how many, how many public, the amount and the first and last one",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "experiments"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "experiments"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT kind, currency, payments, public_payments, amount, first_at, last_at FROM supporter_counts ORDER BY payments DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": []
      }
    }
  ]
}
