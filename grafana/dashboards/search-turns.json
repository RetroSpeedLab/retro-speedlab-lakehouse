        "type": "query",
        "name": "game",
        "label": "Game",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "experiments"
        },
        "query": "SELECT DISTINCT game FROM search_turns UNION SELECT DISTINCT game FROM ppo_rounds",
        "definition": "SELECT DISTINCT game FROM search_turns UNION SELECT DISTINCT game FROM ppo_rounds",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      },
      {
        "type": "query",
        "name": "release",
        "label": "Release",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "experiments"
        },
        "query": "SELECT DISTINCT release FROM search_turn_minutes WHERE game = '$game'",
        "definition": "SELECT DISTINCT release FROM search_turn_minutes WHERE game = '$game'",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {}
      },
      {
        "type": "query",
        "name": "version",
        "label": "Version",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "experiments"
        },
        "query": "SELECT DISTINCT game_version FROM search_turns WHERE game = '$game'",
        "definition": "SELECT DISTINCT game_version FROM search_turns WHERE game = '$game'",
        "refresh": 1,
