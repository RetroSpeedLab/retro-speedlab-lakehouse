  "panels": [
    {
      "type": "timeseries",
      "title": "Frames saved per hour, per turn",
      "description": "Every turn of the game at its start, by the arm that split its workers",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "experiments"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "experiments"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT started_at AS time, arm AS metric, frames_saved_per_hour AS value FROM search_turns WHERE game = '$game' AND game_version IN ($version) AND $__timeFilter(started_at) ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "spanNulls": true,
            "showPoints": "never",
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": []
      }
    },
