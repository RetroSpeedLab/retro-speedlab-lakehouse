      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "experiments"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT run, release, game_version, min(started_at) AS started_at, max(ended_at) AS ended_at, max(round) AS rounds, max(reward) AS best_reward, hyperparameters::json->>'category' AS category, hyperparameters::json->>'policy_emulators' AS policy_emulators, hyperparameters::json->>'rollout_decisions' AS rollout_decisions, hyperparameters::json->>'hidden' AS hidden, hyperparameters::json->>'minibatch' AS minibatch, hyperparameters::json->>'epochs' AS epochs, hyperparameters::json->>'learning_rate' AS learning_rate, hyperparameters::json->>'entropy_weight' AS entropy_weight FROM ppo_rounds WHERE game = '$game' AND release IN ($release) AND game_version IN ($version) GROUP BY run, release, game_version, hyperparameters ORDER BY 4 DESC"
