          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "experiments"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT measured_at AS time, left(run, 8) AS metric, reward AS value FROM ppo_rounds WHERE game = '$game' AND release IN ($release) AND game_version IN ($version) AND run IN ($run) AND $__timeFilter(measured_at) ORDER BY 1"
        }
