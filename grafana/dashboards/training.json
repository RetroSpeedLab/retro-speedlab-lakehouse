    {
      "type": "table",
      "title": "Runs and hyperparameters",
      "description": "Every PPO run of the game with its hyperparameters",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "experiments"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
