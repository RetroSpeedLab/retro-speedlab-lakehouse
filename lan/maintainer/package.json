{
  "name": "retro-speedlab-maintainer-view",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=esm --minify --legal-comments=eof --outfile=../tools/maintainer/a2ui.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "preview": "node preview.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@a2ui/lit": "0.16.0",
    "@a2ui/markdown-it": "0.2.4",
    "@a2ui/web_core": "0.16.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  }
}
